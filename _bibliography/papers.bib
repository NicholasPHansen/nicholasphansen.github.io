@article{aggerholm2025docking,
  bibtex_show = {true},
  abbr        = {IFAC},
  title       = {{SLAM} for Autonomous Docking: A Case Study of Copenhagen's Harbour Buses},
  author      = {Aggerholm, Oda B. and Prabowo, Yaqub A. and Hansen, Peter N. and Galeazzi, Roberto},
  journal     = {IFAC-PapersOnLine},
  volume      = {59},
  number      = {22},
  pages       = {165--170},
  year        = {2025},
  issn        = {2405-8963},
  publisher   = {Elsevier},
  doi         = {10.1016/j.ifacol.2025.11.626},
  abstract    = {Autonomous docking, particularly for harbour buses, requires precise localization and mapping to ensure reliable operation. This paper presents the implementation of a SLAM solution designed to ensure accurate localization and mapping for Copenhagen's harbour buses while enabling reliable detection of docking platforms. The proposed approach utilizes data collected from the harbour bus route and leverages the FAST-LIO2 algorithm and a detection module based on point cloud registration.},
  keywords    = {Autonomous docking, SLAM, harbour bus}
}

